// Automatic Night Light
// Reads ambient light using a photoresistor
// turns an led on when the environment gets dark

const int ledPin = 13;


void setup() {
 Serial.begin(9600); 
pinMode(ledPin, OUTPUT);
}

void loop() {
  int lightValue = analogRead(A0);

Serial.println(lightValue);

if (lightValue < 300) {
  digitalWrite(ledPin, HIGH);
}
else {
  digitalWrite(ledPin, LOW);
}

delay(500);
}

